{
  "name": "@ruleatlas/ui",
  "version": "0.1.0",
  "description": "RuleAtlas React UI component library (presentational, app-independent components).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "yarn run vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@eslint/js": "10.0.1",
    "@types/jest-axe": "3.5.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.0.3",
    "eslint-plugin-react-hooks": "7.1.0",
    "jest-axe": "10.0.0",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SignalSafeSoftware/ruleatlas-ui"
  },
  "private": false
}
